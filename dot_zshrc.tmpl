export PATH="${HOME}/.local/bin:${HOME}/.bun/bin:${PATH}"
export PATH="${PATH}:${HOME}/.lmstudio/bin"

# Load Homebrew from its standard macOS or Linux location when available.
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
elif [[ -x "/opt/homebrew/bin/brew" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if [[ -n "${HOMEBREW_PREFIX:-}" && -d "${HOMEBREW_PREFIX}/opt/ncurses/bin" ]]; then
  export PATH="${HOMEBREW_PREFIX}/opt/ncurses/bin:${PATH}"
fi

# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Add in zsh plugins
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions
zinit light Aloxaf/fzf-tab

# Add in snippets
zinit snippet OMZP::git
zinit snippet OMZP::sudo
zinit snippet OMZP::archlinux
zinit snippet OMZP::command-not-found

# Load completions
autoload -Uz compinit && compinit

zinit cdreplay -q

# Keybindings
bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups
export HISTSIZE HISTFILE SAVEHIST HISTDUP

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -la $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls -la $realpath'

# Aliases
if [[ "$OSTYPE" == darwin* ]]; then
  alias ls='ls -G'
else
  alias ls='ls --color=auto'
fi
alias vim='nvim'
alias c='clear'

# Mise installation and activation function
setup_mise() {
  # Check if mise is installed in ~/.local/bin (where the installer puts it)
  if [ ! -x "${HOME}/.local/bin/mise" ] && ! command -v mise >/dev/null 2>&1; then
    echo "mise not found, installing..."
    curl https://mise.run | sh
  fi

  # Activate mise if it's now available
  if [ -x "${HOME}/.local/bin/mise" ]; then
    eval "$(${HOME}/.local/bin/mise activate zsh)"
  elif command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
  else
    echo "Failed to install or locate mise"
  fi
}

# Language setup function using mise
setup_langs() {
  # Check if mise is available before proceeding
  if [ ! -f "${HOME}/.local/bin/mise" ]; then
    echo "mise not found, skipping language setup"
    return 1
  fi

  echo "Setting up languages with mise..."
  
  # Install bun
  if ! ${HOME}/.local/bin/mise list | grep -q "bun"; then
    echo "Installing bun..."
    ${HOME}/.local/bin/mise use -g bun@latest
  fi
  
  # Install npm/node
  if ! ${HOME}/.local/bin/mise list | grep -q "node"; then
    echo "Installing node/npm..."
    ${HOME}/.local/bin/mise use -g node@lts
  fi

  # Install pnpm
  if ! ${HOME}/.local/bin/mise list | grep -q "pnpm"; then
    echo "Installing pnpm..."
    ${HOME}/.local/bin/mise use -g pnpm@latest
  fi
  
  # Install uv
  if ! ${HOME}/.local/bin/mise list | grep -q "uv"; then
    echo "Installing uv..."
    ${HOME}/.local/bin/mise use -g uv@latest
  fi
  
  # Install python
  if ! ${HOME}/.local/bin/mise list | grep -q "python"; then
    echo "Installing python..."
    ${HOME}/.local/bin/mise use -g python@3.15
  fi
  
  # Install go
  if ! ${HOME}/.local/bin/mise list | grep -q "go"; then
    echo "Installing go..."
    ${HOME}/.local/bin/mise use -g go@latest
  fi
  
  # Install ruby
  if ! ${HOME}/.local/bin/mise list | grep -q "ruby"; then
    echo "Installing ruby..."
    ${HOME}/.local/bin/mise use -g ruby@4
  fi
  
  echo "Language setup complete!"
}

# Install AI tools through mise. OpenCode stays on Bun on macOS.
ensure_mise_settings() {
  local expected='claude,codex,cursor-agent,herdr,opencode,pi'
  local current raw
  raw=$(mise settings get minimum_release_age_excludes 2>/dev/null) || raw=""
  current=$(printf '%s\n' "$raw" | tr -d '[]"[:space:]' | tr ',' '\n' | sort | paste -sd, -)

  if [[ "$current" != "$expected" ]]; then
    mise settings set minimum_release_age_excludes "$expected"
  fi
}

ensure_ai_tools() {
  if ! command -v mise >/dev/null 2>&1; then
    echo "mise is unavailable; skipping AI tool setup"
    return 1
  fi
  ensure_mise_settings || return 1

  local tools=(herdr@latest codex@latest claude@latest pi@latest cursor-agent@latest)
  if [[ "$OSTYPE" != darwin* ]]; then
    tools+=(opencode@latest)
  fi
  mise use --global --yes --fuzzy "${tools[@]}" || return 1

  if [[ "$OSTYPE" == darwin* ]]; then
    if ! command -v bun >/dev/null 2>&1; then
      echo "bun is unavailable; skipping OpenCode installation"
      return 1
    fi
    if ! bun pm ls -g 2>/dev/null | grep -Fq 'opencode-ai@'; then
      echo "Installing opencode with Bun..."
      bun install -g opencode-ai || return 1
    fi
  fi
}

update_ai_tools() {
  if ! command -v mise >/dev/null 2>&1; then
    echo "mise is unavailable; cannot update AI tools"
    return 1
  fi

  if [[ "$OSTYPE" == darwin* ]]; then
    mise up --exclude opencode || return 1
    if command -v opencode >/dev/null 2>&1; then
      opencode upgrade
    else
      echo "opencode is unavailable; install it with ensure_ai_tools first"
      return 1
    fi
  else
    mise up
  fi
}

# Ensure required CLI tools are available via Homebrew
ensure_brew_tool() {
  local binary="$1"
  local formula="${2:-$1}"

  if command -v "${binary}" >/dev/null 2>&1; then
    return 0
  fi

  if command -v brew >/dev/null 2>&1; then
    echo "${binary} not found, installing ${formula} with Homebrew..."
    if ! brew list "${formula}" >/dev/null 2>&1; then
      brew install "${formula}"
    fi
  else
    echo "${binary} not found and Homebrew is unavailable; skipping install"
  fi
}

# Run mise setup
setup_mise

# Optionally run language setup (uncomment to enable)
# setup_langs

# Ensure the AI tools are installed through mise (OpenCode uses Bun on macOS).
ensure_ai_tools

# Run update_ai_tools when you want to update all managed tools.

